# Sao chép file này thành .env nếu cần cấu hình.
# File .env đã nằm trong .gitignore nên sẽ không bị đẩy lên Git.
#
# Trên Vercel, đặt các biến này ở  Settings → Environment Variables
# (KHÔNG commit giá trị thật vào Git).

# ─────────────────────────────────────────────────────────────────────
# Các origin được phép gọi /api/place và /api/sheet, cách nhau bởi dấu phẩy.
# Để trống nếu trang web và API chạy cùng một domain (trường hợp Vercel thường gặp).
# Chỉ cần điền khi tách domain, ví dụ khi trang nằm trên GitHub Pages:
#   ALLOWED_ORIGINS=https://ten-ban.github.io
ALLOWED_ORIGINS=

# ─────────────────────────────────────────────────────────────────────
# ĐỒNG BỘ GOOGLE SHEET (tuỳ chọn — không có thì trang vẫn chạy, chỉ lưu ở trình duyệt)
#
# Hai giá trị dưới đây mở được Google Sheet của bạn, nên chúng chỉ nằm ở
# máy chủ. Trình duyệt người xem chỉ thấy đường dẫn "/api/sheet".
# Cách lấy: làm theo hướng dẫn ở đầu file tools/sheet-appscript.gs
#
# Đường dẫn /exec của Apps Script Web App deploy từ Sheet của bạn:
#   SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycb.../exec
SHEETS_WEBHOOK_URL=

# Chuỗi bí mật tự nghĩ, phải trùng đúng biến SHEET_TOKEN trong tools/sheet-appscript.gs:
SHEETS_TOKEN=
