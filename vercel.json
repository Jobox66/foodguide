{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/place.js": {
      "maxDuration": 20
    },
    "api/sheet.js": {
      "maxDuration": 60
    },
    "api/photo.js": {
      "maxDuration": 20
    }
  },
  "headers": [
    {
      "source": "/api/place",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/api/sheet",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
