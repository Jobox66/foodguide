# =====================================================================
# FOODGUIDE - CẤU HÌNH BIẾN MÔI TRƯỜNG TẬP TRUNG
# =====================================================================
# Sao chép file này thành .env nếu chưa có: cp .env.example .env
# File .env đã nằm trong .gitignore nên TUYỆT ĐỐI không bị đẩy lên Git.
#
# Trên Vercel, đặt các biến ở Settings → Environment Variables
# (KHÔNG commit giá trị thật vào Git).

# ─────────────────────────────────────────────────────────────────────
# 1. WEB & VERCEL API (/api/place, /api/sheet)
# ─────────────────────────────────────────────────────────────────────

# Các origin được phép gọi /api/place và /api/sheet, cách nhau bởi dấu phẩy.
# Để trống nếu trang web và API chạy cùng một domain (trường hợp Vercel thường gặp).
# Chỉ cần điền khi tách domain, ví dụ khi trang nằm trên GitHub Pages:
#   ALLOWED_ORIGINS=https://ten-ban.github.io
ALLOWED_ORIGINS=

# ĐỒNG BỘ GOOGLE SHEET (tuỳ chọn — không có thì trang vẫn chạy, chỉ lưu ở trình duyệt)
#
# Hai giá trị dưới đây mở được Google Sheet của bạn, nên chúng chỉ nằm ở
# máy chủ. Trình duyệt người xem chỉ thấy đường dẫn "/api/sheet".
# Cách lấy: làm theo hướng dẫn ở đầu file tools/sheet-appscript.gs
#
# Đường dẫn /exec của Apps Script Web App deploy từ Sheet của bạn:
#   SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycb.../exec
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbwHz7aZ4KFVitLBVyN6qu9r93s8oskz3CRdXh1yXfpPG-M9D2br6t_zzQS_0LQUOi9m/exec

# Chuỗi bí mật tự nghĩ, phải trùng đúng biến SHEET_TOKEN trong tools/sheet-appscript.gs:
SHEETS_TOKEN=  


# ─────────────────────────────────────────────────────────────────────
# 2. CRAWLER & AI (dành cho các script trong thư mục crawler/)
# ─────────────────────────────────────────────────────────────────────

# Địa chỉ trang đã deploy — tool đẩy dữ liệu qua /api/sheet của chính nó,
# nên không cần service account, không cần thêm file khoá nào.
# Mặc định: https://ten-trang-cua-ban.vercel.app hoặc http://localhost:3000
FOODGUIDE_API=https://angihanoi.vercel.app

# Tab đích. Để nguyên Crawl_Inbox: dữ liệu máy cào phải qua tay bạn duyệt
# rồi mới sang tab chính.
FOODGUIDE_SHEET_TAB=Crawl_Inbox

# Khoá Gemini cho bước trích xuất văn bản bài viết, lấy miễn phí ở:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Tốc độ cào — cào chậm là cách rẻ nhất để không bị chặn
CRAWL_DELAY=3.0
CRAWL_MAX_PAGES=10
