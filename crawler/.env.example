# Chép file này thành crawler/.env rồi điền. File .env không bị đẩy lên Git.

# Địa chỉ trang đã deploy — tool đẩy dữ liệu qua /api/sheet của chính nó,
# nên không cần service account, không cần thêm file khoá nào.
FOODGUIDE_API=https://ten-trang-cua-ban.vercel.app

# Tab đích. Để nguyên Crawl_Inbox: dữ liệu máy cào phải qua tay bạn duyệt
# rồi mới sang tab chính.
FOODGUIDE_SHEET_TAB=Crawl_Inbox

# Khoá Gemini cho bước 3, lấy miễn phí ở https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Cào chậm thôi — đây là cách rẻ nhất để không bị chặn
CRAWL_DELAY=3.0
CRAWL_MAX_PAGES=10
