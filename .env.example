# Sao chép file này thành .env rồi điền khoá thật vào.
# File .env đã nằm trong .gitignore nên sẽ không bị đẩy lên Git.

# Khoá Google Places API (New) - lấy tại https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=AIza...

# Tuỳ chọn: các origin được phép gọi /api/place, cách nhau bởi dấu phẩy.
# Để trống nếu trang web và API chạy cùng một domain (trường hợp Vercel thường gặp).
# Ví dụ khi tách domain: ALLOWED_ORIGINS=https://ten-ban.github.io
ALLOWED_ORIGINS=
